<Project Sdk="Microsoft.NET.Sdk">

  <!--
    MCP 即插即用层：声明式清单 / JSON-RPC 客户端 / 健康心跳 / 对账循环 / 工具桥接。
    stdio 托管进程本期仅留配置位（transport=stdio 时显式报「暂未实现」），不静默假装支持。
  -->
  <PropertyGroup>
    <RootNamespace>Wizstar.Mcp</RootNamespace>
    <AssemblyName>Wizstar.Mcp</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Wizstar.Contracts\Wizstar.Contracts.csproj" />
    <ProjectReference Include="..\Wizstar.Agents\Wizstar.Agents.csproj" />
  </ItemGroup>

</Project>
