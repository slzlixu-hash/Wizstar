{
  "name": "mcp-1688",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MAF 架构下的 1688 采购 MCP 服务：Streamable HTTP + MCP-HMAC 鉴权 + 本地幂等账本，把 1688 浏览器/接口能力包装成可审计、可重放的语义工具。",
  "bin": {
    "mcp-1688": "src/index.js"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --env-file-if-exists=.env src/index.js",
    "test": "node --test test/unit/auth.test.mjs test/unit/credentials.test.mjs test/unit/ledger.test.mjs test/unit/supplier-filters.test.mjs test/http-contract.test.mjs",
    "test:unit": "node --test test/unit/auth.test.mjs test/unit/credentials.test.mjs test/unit/ledger.test.mjs test/unit/supplier-filters.test.mjs",
    "sign": "node scripts/sign.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "iconv-lite": "^0.6.3",
    "playwright-core": "^1.49.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "zod": "^3.23.8"
  }
}
